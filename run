#!/usr/bin/env bash
# Lệnh tắt cho đồ án — gõ ngắn, không phải nhớ tham số dài.
#
#   ./run              (hoặc ./run help)   → xem danh sách lệnh
#   ./run demo                             → demo webcam mượt + ghi video/số liệu
#   ./run test                             → test nhanh (~10 giây)
#
# Script tự: vào thư mục repo + bật môi trường conda `samurai`, nên bạn KHÔNG cần
# chạy `source ~/miniconda3/... && conda activate samurai` trước.
set -uo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT"

PYTHON="${PYTHON:-python}"

# --- tự bật môi trường nếu chưa ---
activate_env() {
  if [ "${CONDA_DEFAULT_ENV:-}" = "samurai" ]; then
    return 0
  fi
  if [ -f "$HOME/miniconda3/etc/profile.d/conda.sh" ]; then
    # shellcheck disable=SC1091
    source "$HOME/miniconda3/etc/profile.d/conda.sh"
    conda activate samurai
  elif command -v conda >/dev/null 2>&1; then
    conda activate samurai
  fi
  if ! command -v "$PYTHON" >/dev/null 2>&1; then
    echo "[LOI] không tìm thấy python. Cài môi trường theo README mục 1,"
    echo "      hoặc chạy thủ công: source ~/miniconda3/etc/profile.d/conda.sh && conda activate samurai"
    exit 1
  fi
}

# --- Bản cũ (tag demo-baseline-…) chạy trong worktree riêng: cứu cánh khi bản web lỗi ---
BASELINE_TAG="${CAM_BASELINE_TAG:-demo-baseline-2026-11-08}"
# CAM_BASELINE_DIR chỉ để test được (trỏ thư mục tạm) — mặc định .baseline/ trong repo.
BASELINE_DIR="${CAM_BASELINE_DIR:-$ROOT/.baseline}"
BASELINE_MARK="$BASELINE_DIR/.demobase-tag"

_baseline_link_resources() {
  # Tài nguyên KHÔNG track trong git (.gitignore: samurai, models, data/*.mp4) → symlink
  # sang bản dùng chung; thiếu checkpoint/model thì bản cũ không chạy được.
  # `-sfn` + `-L`: link ĐỨT (bản dùng chung bị clone lại) phải tạo lại được — `-e` đi theo link
  # nên link đứt trông như "không tồn tại" với `ln -s` thường (review độc lập 14-11, P2).
  for _d in samurai models; do
    if [ -e "$ROOT/$_d" ] && { [ ! -e "$BASELINE_DIR/$_d" ] || [ -L "$BASELINE_DIR/$_d" ]; }; then
      ln -sfn "../$_d" "$BASELINE_DIR/$_d"
    fi
  done
  # Video demo: chỉ link file bản cũ CHƯA có — không ghi đè/xoá file nào.
  if [ -d "$ROOT/data" ] && [ -d "$BASELINE_DIR/data" ]; then
    for _f in "$ROOT"/data/*.mp4; do
      [ -e "$_f" ] || continue
      _name="$(basename "$_f")"
      if [ ! -e "$BASELINE_DIR/data/$_name" ] || [ -L "$BASELINE_DIR/data/$_name" ]; then
        ln -sfn "../../data/$_name" "$BASELINE_DIR/data/$_name"
      fi
    done
  fi
  chmod +x "$BASELINE_DIR/run" 2>/dev/null
  return 0
}

_baseline_write_mark() {
  echo "$BASELINE_TAG" > "$BASELINE_MARK" 2>/dev/null
  # ĐÃ THỬ và KHÔNG dùng được cách dọn `git status` của bản cũ: git KHÔNG đọc `info/exclude`
  # của git-dir thuộc worktree (đo 14-11: `git -C .baseline check-ignore -v .demobase-tag`
  # thoát 1), còn ghi vào `.git/info/exclude` DÙNG CHUNG thì sẽ che cả repo chính.
  # ⇒ `.baseline` tự hiện `?? .demobase-tag/?? samurai/?? models` — chỉ là rác trong thư mục
  # sinh tự động, repo chính vẫn sạch (`/.baseline/` trong .gitignore).
  return 0
}

ensure_baseline() {
  # Nhánh NHANH (đã đúng bản): chỉ cần bảo đảm symlink tài nguyên còn sống (rẻ, idempotent).
  # Không đòi tag phải có trong repo: `.baseline` có thể dựng từ máy khác rồi copy sang.
  if [ -x "$BASELINE_DIR/run" ] && [ "$(cat "$BASELINE_MARK" 2>/dev/null)" = "$BASELINE_TAG" ]; then
    _baseline_link_resources
    _baseline_write_mark
    return 0
  fi
  # Cần DỰNG hoặc ĐỔI bản → tag phải có THẬT. Kiểm TRƯỚC mọi lệnh git khác: review độc lập 14-11
  # (P1) bắt được ca HAI `rev-parse` cùng rỗng bị coi là "khớp" ⇒ ghi mark cho tag KHÔNG tồn tại
  # rồi chạy nhầm code cũ mãi mãi, thoát 0.
  local want
  want="$(git -C "$ROOT" rev-parse --verify --quiet "${BASELINE_TAG}^{commit}" 2>/dev/null)"
  if [ -z "$want" ]; then
    echo "[demobase] không thấy tag $BASELINE_TAG trong repo này."
    echo "           lấy tag về: git fetch --tags origin    |    xem tag có: git tag"
    return 1
  fi
  if [ -x "$BASELINE_DIR/run" ]; then
    if ! git -C "$BASELINE_DIR" rev-parse --git-dir >/dev/null 2>&1; then
      echo "[demobase] $BASELINE_DIR có code nhưng KHÔNG phải bản git (dựng bằng archive)."
      echo "           Muốn đổi sang tag $BASELINE_TAG: rm -rf \"$BASELINE_DIR\" && git worktree prune"
      echo "           (hoặc bỏ dòng CAM_BASELINE_TAG để dùng lại bản đang có)."
      return 1
    fi
    echo "[demobase] đổi bản cũ: $(cat "$BASELINE_MARK" 2>/dev/null || echo '?') → $BASELINE_TAG"
    # `checkout -f`: dọn luôn cây checkout dở (Ctrl+C giữa lúc dựng) thay vì tin là đủ file.
    git -C "$BASELINE_DIR" checkout -f --detach "$BASELINE_TAG" >/dev/null 2>&1 || {
      echo "[demobase] không checkout được tag $BASELINE_TAG trong $BASELINE_DIR"
      echo "           Sửa: rm -rf \"$BASELINE_DIR\" && git worktree prune   (rồi chạy lại)"
      return 1
    }
    _baseline_link_resources
    _baseline_write_mark
    return 0
  fi
  echo "[demobase] dựng bản cũ $BASELINE_TAG ở $BASELINE_DIR (không đổi nhánh, không đụng web/)…"
  # Worktree đã "chết" (thư mục bị xoá tay) không được chặn `worktree add`.
  git -C "$ROOT" worktree prune >/dev/null 2>&1
  # Worktree riêng ⇒ nhánh đang làm + web/dist giữ nguyên. Git trong WSL ghi LF
  # (repo đã đặt core.autocrlf=false) nên ./run trong đó chạy được, không bị "bash\r".
  if ! git -C "$ROOT" worktree add --detach "$BASELINE_DIR" "$BASELINE_TAG" >/dev/null 2>&1; then
    # Dự phòng khi không dùng được worktree: trích thẳng nội dung tag ra thư mục.
    echo "[demobase] không tạo được worktree → trích nội dung tag bằng git archive."
    mkdir -p "$BASELINE_DIR" || return 1
    git -C "$ROOT" archive "$BASELINE_TAG" | tar -x -C "$BASELINE_DIR" || {
      echo "[demobase] git archive thất bại — kiểm tag: git tag | grep $BASELINE_TAG"
      return 1
    }
  fi
  _baseline_link_resources
  _baseline_write_mark
  echo "[demobase] xong → $BASELINE_DIR ($BASELINE_TAG)"
}

usage() {
  cat <<'EOF'
Lệnh tắt của đồ án Camera AI — ./run <lệnh>

  DEMO
    demo            Demo webcam mượt + ghi data/webcam_smooth.mp4 + CSV + JSON
    demo5           Demo 5 khung rồi tự thoát (kiểm tra môi trường ~20 giây)
    view            Chỉ mở cửa sổ xem, không ghi file
    video [file]    Demo trên video file (mặc định data/_gui_test.mp4)
    fast            Demo bản nhanh (image_size 256 → ~6,5 FPS) + TỰ GHI
                    data/fast_<mốc-giờ>.mp4 + CSV/JSON + run_info để xem lại/phân tích
                    (mặc định cue=object — bám VẬT; đổi: --reid-cue face|both)
    demobase [lệnh] Chạy BẢN CŨ (mặc định tag demo-baseline-2026-11-08) trong worktree .baseline/ —
                    dự phòng khi bản web lỗi. Không đổi nhánh, không đụng web/.
                    Mặc định: demoip (camera qua relay). Đổi tag: CAM_BASELINE_TAG=<tag>
                    File ghi ra: .baseline/data/   Ví dụ: ./run demobase video data/binh1.mp4

  NGUỒN CAMERA
    check [nguồn]   Kiểm nguồn 5 giây (mặc định 0 = webcam)
    phone           Quét LAN tìm URL camera điện thoại
    cam             Hướng dẫn cấp lại webcam cho WSL (usbipd, chạy trên Windows)
    relay           Bật camera relay Windows→WSL (khi usbipd kẹt "Device busy (exported)")
    demoip          Demo bám VẬT bằng webcam qua relay (không cần usbipd)

  TÁI NHẬN DIỆN VẬT THỂ (ticket 10)
    reid <video> <x,y,w,h> [--max-frames N]
                    Test mất dấu → tìm lại vật: headless, ghi data/reid_hud.mp4
                    + data/reid_metrics.csv + data/reid_summary.json
    calibrate <csv> [--good …] [--bad …]
                    Hiệu chỉnh ngưỡng nhận lại từ CSV có nhãn (--list để xem sự kiện)

  KIỂM TRA CHẤT LƯỢNG
    test            Test nhanh (~30 giây, không cần checkpoint)
    testall         Toàn bộ test (~2 phút, cần checkpoint)
    lint            ruff check .

  WEB (API + giao diện)
    api [cổng]     Chạy backend FastAPI (mặc định 8000) → /docs để thử API
    web            Build frontend React → API tự phục vụ ở "/" (một lệnh là có demo)
    webdev         Chạy Vite dev server (cần ./run api ở terminal khác)
    webtest        Test frontend bằng vitest (toán học canvas, hàm thuần)
    e2e            E2E TRÌNH DUYỆT THẬT: Chrome/Edge lái giao diện, kéo chuột chọn vật,
                   chờ job xong, kiểm video + bảng số liệu + tải CSV (cần Windows + playwright)

  SỐ LIỆU & BÁO CÁO
    raw [giây]      Ghi video GỐC (không HUD, không model) để phân tích offline
                    → data/raw_<mốc-giờ>.mp4
    charts [csv…]   Vẽ biểu đồ từ CSV (mặc định data/smooth_metrics.csv)
    light [khung]   Thí nghiệm ĐỔI ÁNH SÁNG: IoU theo mức sáng (yêu cầu 11) → data/charts/
    occl  [khung]   Thí nghiệm BỊ CHE KHUẤT: IoU theo khung → data/charts/
    summary         In tóm tắt các file *_summary.json đang có (kèm CPU/RAM)
    gpu             In link Colab + lệnh chạy GPU

  KHÁC
    env             In trạng thái môi trường (python, torch, opencv, webcam, GUI)
    help            In bảng này

Ví dụ:  ./run demo      ./run check 0      ./run charts data/gpu_metrics.csv
EOF
}

cmd="${1:-help}"
shift || true

case "$cmd" in
  demo)
    activate_env
    if [ ! -e /dev/video0 ]; then
      cat <<'EOF'
[demo] CHƯA có webcam trong WSL (/dev/video0 không tồn tại).
  Cách 1 — gắn webcam laptop vào WSL (tự dò BUSID):   ./run cam attach
  Cách 2 — demo bằng video (không cần webcam):        ./run video
  Cách 3 — kiểm nguồn camera trước:                    ./run check 0
EOF
      exit 1
    fi
    bash scripts/demo_webcam.sh "$@"
    echo
    echo "[demo] xem kết quả:  ./run summary   (bảng số)   |   ./run charts   (biểu đồ)"
    ;;
  demo5)
    activate_env
    bash scripts/demo_webcam.sh --max-frames 5 "$@"
    ;;
  demobase)
    # Dự phòng "bản demo cũ chạy được" khi bản web gặp sự cố: chạy NGUYÊN code của tag cũ
    # trong worktree .baseline/, nhánh đang làm và web/dist không bị đụng tới.
    #   ./run demobase                      → bản cũ: ./run demoip  (webcam qua relay)
    #   ./run demobase demoip --max-frames 100
    #   ./run demobase video data/binh1.mp4
    #   ./run demobase help                 → bảng lệnh của bản cũ
    if [ $# -eq 0 ] || [ "${1#-}" != "$1" ]; then
      # Không có lệnh con (hoặc mở đầu bằng cờ) → mặc định demoip. Riêng -h/--help thì in help,
      # KHÔNG bật relay chỉ để xem trợ giúp (review độc lập 14-11, P3).
      case "${1:-}" in
        -h|--help) _sub="help"; shift || true ;;
        *) _sub="demoip" ;;
      esac
    else
      _sub="$1"; shift
    fi
    ensure_baseline || exit 1
    printf '[demobase] %s: ./run %s' "$BASELINE_TAG" "$_sub"
    if [ $# -gt 0 ]; then printf ' %q' "$@"; fi
    printf '\n[demobase] file ghi ra: %s/data/\n' "$BASELINE_DIR"
    exec bash "$BASELINE_DIR/run" "$_sub" "$@"
    ;;
  view)
    activate_env
    # Tham số đầu là NGUỒN chỉ khi nó KHÔNG phải cờ (không bắt đầu bằng '-').
    # Bug thật 27-10: `./run fast --reid-cue object` → coi "--reid-cue" là source, "object" thành
    # tham số lạ → argparse in usage + lỗi. Không có nguồn thì mặc định 0 (webcam).
    if [ $# -gt 0 ] && [ "${1#-}" = "$1" ]; then
      src_view="$1"; shift
    else
      src_view=0
    fi
    exec "$PYTHON" tools/run_live.py --source "$src_view" --display --smooth --reid \
      --image-size 384 "$@"
    ;;
  video)
    activate_env
    # Như `view`/`fast`: chỉ lấy $1 làm nguồn khi nó KHÔNG phải cờ. Bug 27-10 còn sót ở đây:
    # `./run video --device cuda` từng bị đọc thành --source "--device" ⇒ argparse lỗi
    # (review độc lập 10-11 bắt khi viết tài liệu chạy GPU).
    if [ $# -gt 0 ] && [ "${1#-}" = "$1" ]; then
      video="$1"; shift
    else
      video=data/_gui_test.mp4
    fi
    exec "$PYTHON" tools/run_live.py --source "$video" --display --smooth --reid --image-size 384 "$@"
    ;;
  relay)
    # Relay webcam Windows → WSL qua HTTP MJPEG: cứu cánh khi usbipd kẹt "exported"
    bash scripts/cam_relay.sh "${1:-start}" "${@:2}"
    ;;
  demoip)
    activate_env
    bash scripts/cam_relay.sh start
    # Dùng ẢNH JPEG RỜI thay vì luồng MJPEG: đo 05-11-2026 → MJPEG read() 30,2 ms/frame
    # vs snapshot 8,4 ms/frame (cùng relay, cùng 640x480).
    _url="$(bash scripts/cam_relay.sh snapurl)"
    echo "[demoip] nguồn: ${_url} (ảnh JPEG rời — rẻ hơn MJPEG ~22 ms/frame)"
    if ! bash scripts/cam_relay.sh status >/dev/null 2>&1; then
      echo "[demoip] relay chưa sẵn sàng — xem hướng dẫn ở trên (./run relay start)."
      exit 1
    fi
    _stamp="$(date +%m%d-%H%M%S)"
    exec "$PYTHON" tools/run_live.py --source "$_url" --display --smooth --reid \
      --reid-cue object --image-size 320 \
      --record "data/demoip_${_stamp}.mp4" \
      --metrics-csv "data/demoip_${_stamp}_metrics.csv" \
      --metrics-summary "data/demoip_${_stamp}_summary.json" "$@"
    ;;
  fast)
    activate_env
    # Như `view`: chỉ lấy $1 làm nguồn khi nó không phải cờ (bug thật 27-10).
    if [ $# -gt 0 ] && [ "${1#-}" = "$1" ]; then
      src_fast="$1"; shift
    else
      src_fast=0
    fi
    # Tự ghi video + số liệu (bug thật 29-10: người dùng chạy `./run fast` rồi tưởng đã lưu video,
    # nhưng `fast` không có --record → không có gì để xem lại/phân tích). Tên có mốc thời gian để
    # không ghi đè lần trước; truyền --record của bạn thì argparse lấy cái sau (của bạn).
    _stamp="$(date +%m%d-%H%M%S)"
    _rec="data/fast_${_stamp}.mp4"
    _csv="data/fast_${_stamp}_metrics.csv"
    _json="data/fast_${_stamp}_summary.json"
    # Bug thật 01-11: `./run fast` không truyền --reid-cue → rơi về cue=face của config.
    # Test bằng VẬT (chai, hộp) thì re-ID có 0 mẫu MẶT → không bao giờ nhận lại
    # (đo: 201 frame, 180 mất dấu, reid_score = -1 suốt phiên). Mặc định bám VẬT;
    # cờ --reid-cue của người dùng đứng SAU nên vẫn đè được (argparse lấy cái sau).
    _fast_cue="object"
    echo "[fast] ghi: ${_rec}  (+ ${_csv}, ${_json}, data/fast_${_stamp}_run_info.json)"
    echo "[fast] re-ID cue=${_fast_cue}  (đổi: --reid-cue face|both)"
    exec "$PYTHON" tools/run_live.py --source "$src_fast" --display --smooth --reid \
      --reid-cue "$_fast_cue" \
      --image-size 256 --record "$_rec" --metrics-csv "$_csv" --metrics-summary "$_json" "$@"
    ;;
  check)
    activate_env
    exec "$PYTHON" tools/check_video_source.py --source "${1:-0}" --num "${2:-10}"
    ;;
  reid)
    activate_env
    if [ $# -lt 2 ]; then
      echo "[LOI] thiếu tham số. Dùng: ./run reid <video> <x,y,w,h> [--max-frames N]"
      echo "      Ví dụ: ./run reid data/binh1.mp4 300,275,150,410 --max-frames 130"
      exit 2
    fi
    reid_video="$1"; reid_bbox="$2"
    shift 2
    exec "$PYTHON" tools/run_live.py --source "$reid_video" --bbox "$reid_bbox" \
      --reid --reid-cue object --image-size 512 \
      --metrics-csv data/reid_metrics.csv --metrics-summary data/reid_summary.json \
      --record data/reid_hud.mp4 "$@"
    ;;
  calibrate)
    activate_env
    exec "$PYTHON" scripts/calibrate_reid.py "$@"
    ;;
  phone)
    activate_env
    exec "$PYTHON" tools/find_phone_camera.py "$@"
    ;;
  cam)
    activate_env
    if [ "${1:-}" = "attach" ]; then
      "$PYTHON" scripts/usbipd_helper.py attach
    else
      "$PYTHON" scripts/usbipd_helper.py status || true
      cat <<'EOF'

Cấp webcam cho WSL — tự tìm BUSID (BUSID ĐỔI sau mỗi lần khởi động lại):
  ./run cam attach        # tự dò BUSID hiện tại rồi attach (không cần Admin)
  ./run cam status        # xem bảng thiết bị usbipd

Nếu báo 'Device busy (exported)' — kẹt ở DRIVER usbipd-win, KHÔNG phải WSL:
  reset WSL (wsl --shutdown) hay reboot đều đã thử và không khỏi (đo 04-11-2026) ⇒ đừng mò lại.
  Dùng đường chắc chạy, webcam Windows → WSL qua HTTP:
    ./run relay           # bật relay, in URL MJPEG
    ./run demoip          # demo bám VẬT bằng webcam qua relay (tự ghi mp4 + metrics)
  Muốn quay lại USB/IP: (Admin) usbipd unbind --busid <BUSID> → reboot → usbipd bind → ./run cam attach
Trước khi tắt máy/WSL, nhớ nhả camera: (PowerShell) usbipd detach --busid <BUSID>
EOF
    fi
    ;;
  test)
    activate_env
    exec "$PYTHON" -m pytest -m "not slow" "$@"
    ;;
  testall)
    activate_env
    exec "$PYTHON" -m pytest "$@"
    ;;
  lint)
    activate_env
    exec "$PYTHON" -m ruff check . "$@"
    ;;
  api)
    activate_env
    port="${1:-8000}"
    echo "[api] thử API: http://127.0.0.1:${port}/docs   (Ctrl+C để dừng)"
    echo "[api] nếu đã chạy ./run web thì mở luôn giao diện: http://127.0.0.1:${port}/"
    exec "$PYTHON" -m uvicorn src.api.main:app --host 127.0.0.1 --port "$port" --reload
    ;;
  webdev)
    # Frontend dev (Vite). Backend phải chạy song song: ./run api
    cd "$ROOT/web" 2>/dev/null || { echo "[LOI] chưa có thư mục web/"; exit 1; }
    [ -d node_modules ] || npm install
    exec npm run dev
    ;;
  web)
    # Build frontend rồi để API phục vụ luôn ở "/" (khỏi cần CORS/2 server khi demo)
    cd "$ROOT/web" 2>/dev/null || { echo "[LOI] chưa có thư mục web/"; exit 1; }
    if [ ! -d node_modules ]; then
      # npm sẽ tự thay symlink bằng thư mục thật, nên cứ để node_modules trong web/.
      # Đo 08-11: cài 67 gói trong 16 s trên /mnt/d (9p) — chấp nhận được, không cần mẹo symlink.
      npm install || exit 1
    fi
    npm run build || exit 1
    echo "[web] đã build web/dist → chạy: ./run api   rồi mở http://127.0.0.1:8000/"
    ;;
  webtest)
    cd "$ROOT/web" 2>/dev/null || { echo "[LOI] chưa có thư mục web/"; exit 1; }
    exec npm test -- "$@"
    ;;
  e2e)
    # E2E bằng TRÌNH DUYỆT THẬT: server chạy trong WSL, Chrome/Edge lái từ Windows qua cmd.exe.
    # Thiếu một trong hai thứ dưới đây thì báo rõ thay vì fail khó hiểu.
    activate_env
    if ! command -v cmd.exe >/dev/null 2>&1; then
      echo "[e2e] cần WSL (script dùng cmd.exe + Chrome/Edge trên Windows)"
      exit 1
    fi
    if [ ! -d "$ROOT/web/node_modules/playwright" ]; then
      echo "[e2e] thiếu playwright → chạy:  cd web && npm i -D playwright"
      exit 1
    fi
    "$PYTHON" scripts/make_e2e_video.py || exit 1
    # LUÔN build lại frontend trước khi lái trình duyệt: `web/dist` cũ ⇒ E2E "PASS" trên mã CŨ.
    # Đã gặp đúng cái bẫy này khi thêm dòng thiết bị (ticket 21, 12-11): server phục vụ dist cũ
    # nên một test mới báo đỏ"không thấy dòng thiết bị" trong khi mã đúng. Build ~2 s.
    ( cd "$ROOT/web" && npm run build >/dev/null 2>&1 ) \
      || { echo "[e2e] build frontend thất bại — chạy ./run web để xem lỗi"; exit 1; }
    port="${E2E_PORT:-8013}"
    "$PYTHON" -m uvicorn src.api.main:app --host 0.0.0.0 --port "$port" \
      > "$ROOT/data/e2e_server.log" 2>&1 &
    srv=$!
    trap 'kill $srv 2>/dev/null' EXIT
    for _ in $(seq 1 25); do curl -sf "localhost:$port/health" >/dev/null && break; sleep 1; done
    win_root="$(wslpath -w "$ROOT")"
    cmd.exe /c "cd /d $win_root && set BASE=http://localhost:$port& node scripts\\e2e_web.js"
    ;;
  raw)
    activate_env
    # Nếu tham số đầu là cờ (vd `./run raw --help`) thì KHÔNG chen --seconds (bug cùng loại với
    # `./run fast --reid-cue` ngày 27-10: ăn cờ làm giá trị).
    if [ $# -gt 0 ] && [ "${1#-}" = "$1" ]; then
      exec "$PYTHON" scripts/record_raw.py --seconds "$1" "${@:2}"
    else
      exec "$PYTHON" scripts/record_raw.py "$@"
    fi
    ;;
  charts)
    activate_env
    if [ "$#" -eq 0 ]; then
      set -- data/smooth_metrics.csv
    fi
    exec "$PYTHON" scripts/plot_metrics.py "$@"
    ;;
  light)
    activate_env
    # Tham số đầu là SỐ KHUNG khi nó không phải cờ (cùng lỗi cần tránh với `./run fast`)
    if [ $# -gt 0 ] && [ "${1#-}" = "$1" ]; then
      exec "$PYTHON" -m scripts.experiment_lighting --frames "$1" "${@:2}"
    fi
    exec "$PYTHON" -m scripts.experiment_lighting "$@"
    ;;
  occl)
    activate_env
    if [ $# -gt 0 ] && [ "${1#-}" = "$1" ]; then
      exec "$PYTHON" -m scripts.experiment_occlusion --frames "$1" "${@:2}"
    fi
    exec "$PYTHON" -m scripts.experiment_occlusion "$@"
    ;;
  summary)
    activate_env
    "$PYTHON" - <<'PY'
import glob, json, os
files = sorted(glob.glob("data/*_summary.json"))
if not files:
    print("Chưa có file *_summary.json — chạy ./run demo hoặc ./run video trước.")
for f in files:
    d = json.load(open(f, encoding="utf-8"))
    # Chỉ file summary của PHIÊN ĐO (có total_frames); file kết quả thí nghiệm khác bỏ qua
    if "total_frames" not in d:
        continue
    res = d.get("resources") or {}
    extra = ""
    if res.get("cpu_percent_mean") is not None:
        extra = f" | CPU {res['cpu_percent_mean']:.0f}% (1 lõi) RAM {res['rss_mb_peak']:.0f} MB"
    print(f"{os.path.basename(f):28} {d.get('total_frames','?'):>4} frame | "
          f"mean={d.get('mean_latency_ms',0):7.0f} ms | p95={d.get('p95_latency_ms',0):7.0f} | "
          f"FPS={d.get('effective_fps',0):5.2f} | mất dấu={d.get('lost_count',0)}{extra}")
PY
    ;;
  gpu)
    cat <<'EOF'
Đo trên GPU (miễn phí, ~10 phút lần đầu):
  Mở: https://colab.research.google.com/github/BinhNguyen1912/DoAn-NAB/blob/main/notebooks/colab_gpu_evaluation.ipynb
  → Runtime → Change runtime type → T4 GPU → Save
  → chạy cell "⚡ CHẠY TẤT CẢ"   (hoặc trong Colab: !python scripts/colab_run_all.py)
  → tải data/colab_gpu_results.zip về máy, chép vào D:\DOAN-NAB\data\
Kỳ vọng (T4, image_size 512, 720p tổng hợp): 49,6 ms/frame ≈ 20,15 FPS
  (mean thô 100,8 ms vì frame 0 warmup CUDA — phải bỏ 5 frame đầu, xem README mục 3)

Demo LIVE trên GPU (worker bám trực tiếp + web):
  ./run web                              # build frontend (KHÔNG khởi động API)
  CAMERA_AI_DEVICE=cuda ./run api        # API đọc biến này lúc khởi động → chuyển xuống worker
  ./run video --device cuda              # đường CLI trên video mặc định
  ./run video data/binh1.mp4 --device cuda
  python tools/live_worker.py --source data/binh1.mp4 --out-dir /tmp/live --device cuda
  Xin cuda mà máy không có GPU ⇒ báo lỗi ngay, KHÔNG âm thầm chạy CPU (README mục 3b)
EOF
    ;;
  env)
    activate_env
    echo "repo      : $ROOT"
    echo "env       : ${CONDA_DEFAULT_ENV:-?}"
    "$PYTHON" - <<'PY'
import shutil, cv2, torch
print("python    :", __import__("sys").version.split()[0], "|", shutil.which("python"))
print("torch     :", torch.__version__, "| CUDA:", torch.cuda.is_available())
print("opencv    :", cv2.__version__)
print("webcam    :", "/dev/video0 có" if __import__("os").path.exists("/dev/video0") else "/dev/video0 KHÔNG có (./run cam)")
print("GUI       :", "DISPLAY=" + (__import__("os").environ.get("DISPLAY") or "(trống)"))
PY
    ;;
  aliases)
    if [ "${1:-}" = "--install" ]; then
      if grep -q "doan camera ai (auto)" "$HOME/.bashrc" 2>/dev/null; then
        echo "Alias đã có trong ~/.bashrc (không thêm trùng)."
      else
        printf '\n' >> "$HOME/.bashrc"
        cat "$ROOT/scripts/aliases.sh" >> "$HOME/.bashrc"
        echo "Đã thêm alias vào ~/.bashrc → mở terminal mới hoặc chạy: source ~/.bashrc"
      fi
    else
      echo "Dán khối sau vào cuối ~/.bashrc (hoặc chạy: ./run aliases --install):"
      echo
      cat "$ROOT/scripts/aliases.sh"
    fi
    ;;
  help|-h|--help)
    usage
    ;;
  *)
    echo "[LOI] không có lệnh '$cmd'."
    echo
    usage
    exit 2
    ;;
esac
