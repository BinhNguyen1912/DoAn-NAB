Thumbs.db
.DS_Store
.idea/
.vscode/

# ===== File tạm của Office / LibreOffice =====
~$*
.~lock.*
# ===== Web (React + Vite): thư mục sinh tự động, cài lại bằng `npm install` =====
web/node_modules/
web/dist/
web/.vite/

# Fixture E2E web (sinh lại bằng scripts/make_e2e_video.py — không commit)
data/e2e_*

# Worktree dùng SYMLINK `samurai`/`models` tới bản dùng chung (không có dấu `/` nên `samurai/` ở
# trên KHÔNG khớp) — nếu không chặn, symlink bị tính là "code bẩn" trong `git_dirty_code` của
# artifact đo (gặp khi đo lại bằng camera thật cho nhánh này).
/samurai
/models
# Dãy mẫu drift từng mẫu (ticket 15): CSV nhỏ (~40 KB/900 mẫu) + provenance của lần đo — phải vào
# Git để "% cửa sổ báo oan" và "phát hiện sau N mẫu" trong báo cáo kiểm chứng lại được.
!data/drift_samples_*.csv
!data/drift_samples_*.meta.json

# Bản cũ chạy bằng `./run demobase` (git worktree tại .baseline/) — sinh tự động, không commit
/.baseline/
